<?xml version="1.0" encoding="utf-8"?>

<!--
  IIS HOSTING CONFIGURATION for ASP.NET Core.

  This is NOT the old Web.config - .NET 10 does not read app
  settings from here. This file only tells IIS how to start the
  app (ASP.NET Core Module). App configuration comes from
  appsettings.json + environment variables on the server.
-->

<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <handlers>
        <add name="aspNetCore"
             path="*"
             verb="*"
             modules="AspNetCoreModuleV2"
             resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet"
                  arguments=".\ITCompliance.API.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />

    </system.webServer>
  </location>
</configuration>
