      <Column Name="Email" Type="System.String" CanBeNull="false" />
      <Column Name="EmpId" Type="System.String" CanBeNull="false" />
      <Column Name="LocationCode" Type="System.String" CanBeNull="false" />
      <Column Name="LocationName" Type="System.String" CanBeNull="false" />
      <Column Name="Name" Type="System.String" CanBeNull="false" />
      <Column Name="RegionCode" Type="System.String" CanBeNull="false" />
      <Column Name="RegionName" Type="System.String" CanBeNull="false" />
    </Type>
  </Table>
  <Table Name="dbo.tbl_Employee" Member="tbl_Employee">
    <Type Name="tbl_Employee">
      <Column Name="CreatedBy" Type="System.Nullable`1" CanBeNull="true" />
      <Column Name="CreatedOn" Type="System.Nullable`1" CanBeNull="true" />
      <Column Name="Dept" Type="System.String" CanBeNull="true" />
      <Column Name="DeviceId" Type="System.String" CanBeNull="true" />
      <Column Name="DeviceStatus" Type="System.String" CanBeNull="true" />
      <Column Name="Email" Type="System.String" CanBeNull="true" />
      <Column Name="EmpId" Type="System.String" CanBeNull="true" />
      <Column Name="EmpName" Type="System.String" CanBeNull="true" />
      <Column Name="Id" Type="System.Int64" CanBeNull="false" />
      <Column Name="IsADUser" Type="System.Nullable`1" CanBeNull="true" />
      <Column Name="IsActive" Type="System.Nullable`1" CanBeNull="true" />
      <Column Name="LogIn" Type="System.Nullable`1" CanBeNull="true" />
      <Column Name="LogOut" Type="System.Nullable`1" CanBeNull="true" />
      <Column Name="ModifiedBy" Type="System.Nullable`1" CanBeNull="true" />
