<?xml version="1.0" encoding="utf-8"?>
<Database Name="ITcomplianceDB" Class="ITcomplianceDBDataContext" xmlns="http://schemas.microsoft.com/linqtosql/dbml/2007">
  <Table Name="dbo.Employees" Member="Employee">
    <Type Name="Employee">
      <Column Name="Id" Type="System.Int32" IsPrimaryKey="true" CanBeNull="false" />
      <Column Name="CellularId" Type="System.String" CanBeNull="false" />
      <Column Name="Department" Type="System.String" CanBeNull="false" />
      <Column Name="Designation" Type="System.String" CanBeNull="false" />
      <Column Name="DeviceName" Type="System.String" CanBeNull="false" />
      <Column Name="EmployeeId" Type="System.String" CanBeNull="false" />
      <Column Name="IpAddress" Type="System.String" CanBeNull="false" />
      <Column Name="LanLaptopId" Type="System.String" CanBeNull="false" />
      <Column Name="LanMacId" Type="System.String" CanBeNull="false" />
      <Column Name="Name" Type="System.String" CanBeNull="false" />
      <Column Name="PasswordHash" Type="System.String" CanBeNull="false" />
      <Column Name="Role" Type="System.String" CanBeNull="false" />
    </Type>
  </Table>
  <Table Name="dbo.InternetAccessRequests" Member="InternetAccessRequest">
    <Type Name="InternetAccessRequest">
      <Column Name="Id" Type="System.Int32" IsPrimaryKey="true" CanBeNull="false" />
      <Column Name="BossRemarks" Type="System.String" CanBeNull="true" />
      <Column Name="CellularId" Type="System.String" CanBeNull="false" />
      <Column Name="CreatedAt" Type="System.DateTime" CanBeNull="false" />
      <Column Name="DeviceName" Type="System.String" CanBeNull="false" />
      <Column Name="Duration" Type="System.String" CanBeNull="false" />
      <Column Name="EmployeeEmail" Type="System.String" CanBeNull="false" />
      <Column Name="EmployeeId" Type="System.String" CanBeNull="false" />
      <Column Name="HODRemarks" Type="System.String" CanBeNull="true" />
      <Column Name="ITOfficerRemarks" Type="System.String" CanBeNull="true" />
      <Column Name="IpAddress" Type="System.String" CanBeNull="false" />
      <Column Name="LanLaptopId" Type="System.String" CanBeNull="false" />
      <Column Name="LanMacId" Type="System.String" CanBeNull="false" />
      <Column Name="Reason" Type="System.String" CanBeNull="false" />
      <Column Name="SecurityHeadRemarks" Type="System.String" CanBeNull="true" />
      <Column Name="Status" Type="System.String" CanBeNull="false" />
      <Column Name="UpdatedAt" Type="System.Nullable`1" CanBeNull="true" />
      <Column Name="Website" Type="System.String" CanBeNull="false" />
    </Type>
  </Table>
  <Table Name="dbo.OES_vuEmployeeDetails" Member="OES_vuEmployeeDetail">
