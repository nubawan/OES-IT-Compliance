@using ITCompliance.API.Models
@inject IWebHostEnvironment Env

@* Config-driven nav, filtered by the user's role claims. Role is
   null for "visible to any authenticated user". *@
@{
    var allNavItems = new List<(string Label, string Icon, string Url, string Section, string? Role)>
    {
        ("My Dashboard",     "i-dashboard", "/Employee/Dashboard",     "",               RoleNames.Employee),
        ("New Request",      "i-plus",      "/Employee/Dashboard?openRequest=1", "",       RoleNames.Employee),
        ("IT Officer",       "i-monitor",   "/ITOfficer/Dashboard",    "Approvals",      RoleNames.ITOfficer),
        ("HOD",              "i-list",      "/HOD/Dashboard",          "Approvals",      RoleNames.HOD),
        ("Security Head",    "i-shield",    "/SecurityHead/Dashboard", "Approvals",      RoleNames.SecurityHead),
        ("Boss",             "i-award",     "/Boss/Dashboard",         "Approvals",      RoleNames.Boss),
        ("Role Management",  "i-users",     "/Admin/Roles",            "Administration", RoleNames.Admin),
        ("Power Login",      "i-key",       "/PowerLogin",             "Developer",      RoleNames.Admin)
    };

    var navItems = allNavItems
        .Where(item =>
            (item.Role == null || User.IsInRole(item.Role)) &&
            (item.Url != "/PowerLogin" || Env.IsDevelopment()))
        .ToList();
}

<link rel="stylesheet"
      href="~/css/sidenav.css"
      asp-append-version="true" />

<aside class="app-sidenav" id="appSidenav">

    <div class="sidenav-brand">
        <img src="~/assets/logo.png" alt="Company Logo" />
        <span class="sidenav-label">IT Compliance</span>
    </div>

    <button type="button"
            class="sidenav-toggle"
            id="sidenavToggle"
            title="Collapse menu">
        <svg class="icon"><use href="#i-menu" /></svg>
    </button>

    <nav class="sidenav-nav">

        @{ string? currentSection = null; }

        @foreach (var item in navItems)
        {
            if (item.Section != currentSection)
            {
                currentSection = item.Section;

                if (item.Section != "")
                {
                    <div class="sidenav-section sidenav-label">
                        @item.Section
                    </div>
                }
            }

            <a class="sidenav-link" href="@item.Url" title="@item.Label">
                <svg class="icon"><use href="#@item.Icon" /></svg>
                <span class="sidenav-label">@item.Label</span>
            </a>
        }

        <div class="sidenav-section sidenav-label">Session</div>

        <a class="sidenav-link sidenav-logout"
           href="/Account/Logout"
           title="Logout">
            <svg class="icon"><use href="#i-logout" /></svg>
            <span class="sidenav-label">Logout</span>
        </a>

    </nav>

</aside>

<script>
    (function () {
        var body = document.body;
        var key = "sidenav-collapsed";

        if (localStorage.getItem(key) === "1") {
            body.classList.add("sidenav-collapsed");
        }

        document.getElementById("sidenavToggle").addEventListener("click", function () {
            body.classList.toggle("sidenav-collapsed");
            localStorage.setItem(key,
                body.classList.contains("sidenav-collapsed") ? "1" : "0");
        });

        document.querySelectorAll(".app-sidenav a").forEach(function (link) {
            if (link.pathname.toLowerCase() === window.location.pathname.toLowerCase()) {
                link.classList.add("active");
            }
        });
    })();
</script>
