@{
    ViewData["Title"] = "New Internet Access Request";
    ViewData["PageSubtitle"] = "Submit a request for internet access";

    var employee = ViewBag.Employee;
}

<div class="form-wrap">

    <div class="form-card">

        
        <div class="form-banner">

            <img src="~/assets/logo.png"
                 alt="Company Logo" />

            <div>

                <h1>Internet Access Request</h1>

                <p>
                    Complete the device details and access
                    requirements below
                </p>

            </div>

        </div>

        
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-error"
                 style="margin-bottom: 20px;">

                <span class="alert-icon">!</span>

                <span>@ViewBag.Error</span>

            </div>
        }

        
        <div class="section-title">
            Employee Information
        </div>

        <div class="form-grid">

            <div class="form-group">

                <label>Employee ID</label>

                <input type="text"
                       value="@employee?.EmpId"
                       readonly />

            </div>

            <div class="form-group">

                <label>Employee Name</label>

                <input type="text"
                       value="@employee?.Name"
                       readonly />

            </div>

            <div class="form-group">

                <label>Employee Email</label>

                <input type="email"
                       value="@employee?.Email"
                       readonly />

            </div>

            <div class="form-group">

                <label>Department</label>

                <input type="text"
                       value="@employee?.DepartmentName"
                       readonly />

            </div>

            <div class="form-group">

                <label>Designation</label>

                <input type="text"
                       value="@employee?.Designation"
                       readonly />

            </div>

        </div>

        
        <form asp-controller="Employee"
              asp-action="SubmitRequest"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="EmployeeId"
                   value="@employee?.EmpId" />

            <input type="hidden"
                   name="EmployeeEmail"
                   value="@employee?.Email" />

            
            <div class="section-title">
                Device Information
            </div>

            <div class="form-group">

                <label for="DeviceName">
                    Device Name
                    <span class="required">*</span>
                </label>

                <input type="text"
                       id="DeviceName"
                       name="DeviceName"
                       placeholder="e.g. LT-FINANCE-014"
                       required />

            </div>

            <div class="form-grid">

                <div class="form-group">

                    <label for="LanMacId">
                        LAN MAC ID
                        <span class="required">*</span>
                    </label>

                    <input type="text"
                           id="LanMacId"
                           name="LanMacId"
                           placeholder="e.g. 00:1A:2B:3C:4D:5E"
                           required />

                </div>

                <div class="form-group">

                    <label for="CellularId">
                        Cellular ID
                        <span class="required">*</span>
                    </label>

                    <input type="text"
                           id="CellularId"
                           name="CellularId"
                           placeholder="Enter Cellular ID"
                           required />

                </div>

            </div>

            <div class="form-grid">

                <div class="form-group">

                    <label for="LanLaptopId">
                        LAN Laptop ID
                        <span class="required">*</span>
                    </label>

                    <input type="text"
                           id="LanLaptopId"
                           name="LanLaptopId"
                           placeholder="Enter LAN Laptop ID"
                           required />

                </div>

                <div class="form-group">

                    <label for="IpAddress">
                        IP Address
                        <span class="required">*</span>
                    </label>

                    <input type="text"
                           id="IpAddress"
                           name="IpAddress"
                           placeholder="e.g. 10.100.20.55"
                           required />

                </div>

            </div>

            
            <div class="section-title">
                Access Details
            </div>

            <div class="form-group">

                <label for="Website">
                    Website / URL
                    <span class="required">*</span>
                </label>

                <input type="text"
                       id="Website"
                       name="Website"
                       placeholder="e.g. https://example.com"
                       required />

            </div>

            <div class="form-group">

                <label for="Reason">
                    Reason for Internet Access
                    <span class="required">*</span>
                </label>

                <textarea id="Reason"
                          name="Reason"
                          rows="4"
                          placeholder="Enter the business reason for requesting internet access..."
                          required></textarea>

            </div>

            <div class="form-group">

                <label for="Duration">
                    Required Duration
                    <span class="required">*</span>
                </label>

                <select id="Duration"
                        name="Duration"
                        required>

                    <option value="">
                        -- Select Duration --
                    </option>

                    <option value="1 Day">1 Day</option>
                    <option value="3 Days">3 Days</option>
                    <option value="1 Week">1 Week</option>
                    <option value="1 Month">1 Month</option>
                    <option value="Permanent">Permanent</option>

                </select>

            </div>

            
            <div class="form-actions">

                <a asp-controller="Employee"
                   asp-action="Dashboard"
                   class="btn btn-ghost">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    Submit Request
                </button>

            </div>

        </form>

    </div>

</div>
